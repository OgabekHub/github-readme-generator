# Environment Variables — GitHub README Generator

# ────────────────────────────────────────────────────────
# Gemini AI (Google AI Studio)
# Get your free key at: https://aistudio.google.com/apikey
# ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ────────────────────────────────────────────────────────
# GitHub Token (optional but recommended)
# Increases API rate limit from 60 → 5000 requests/hour
# Get at: https://github.com/settings/tokens (no scopes needed)
# ────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here

# ────────────────────────────────────────────────────────
# GitHub OAuth Settings
# Required for "1-Click Profile Deploy" and GitHub Login.
# Follow these steps to get your Client ID and Secret:
#
# 1. Go to your GitHub account Settings -> Developer settings -> OAuth Apps
#    Direct Link: https://github.com/settings/developers
# 2. Click "New OAuth App" (or "Register a new application")
# 3. Fill out the form:
#    - Application name: GitHub README Generator
#    - Homepage URL: http://localhost:3000 (or your production URL when deploying)
#    - Authorization callback URL: http://localhost:3000/api/auth/callback
#      (Note: When deploying to Vercel, update the callback URL in your GitHub
#      OAuth settings to match your Vercel URL: https://your-app.vercel.app/api/auth/callback)
# 4. Click "Register application"
# 5. Copy the "Client ID" and paste it below.
# 6. Click "Generate a new client secret", copy it, and paste it below.
# ────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

